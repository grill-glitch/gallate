# full-cli build.jsonl
#
# Trace of:
#   full-cli build ./demo-zh.pfs --yaml
#
# Demonstrates a longer-running operation with phase transitions,
# cancellation handling, and final statistics.

# ----- stdin: request -----

{type: request, id: 01HBUILD, operation: build, input: [{path: ./demo-zh.pfs, kind: file}], output: [{path: ./dist, kind: directory}]}

# ----- stdout -----

{type: response, id: 01HBUILD, operation: build, accepted: true}

{type: event, event: started, id: 01HBUILD, operation: build}

{type: event, event: phase, name: preparing}
{type: event, event: phase, name: scanning}
{type: event, event: progress, current: 1, total: 100}
{type: event, event: progress, current: 25, total: 100}

# ----- stdin: Wrapper sends a cancel command mid-flight -----

{type: command, command: cancel, reason: "user pressed Esc in Wrapper UI"}

# ----- stdout: CLI begins shutdown -----

{type: event, event: phase, name: finalizing}

{type: event, event: cancelled, id: 01HBUILD}

{type: event, event: statistics, statistics: {files: {scanned: 25, processed: 25, failed: 0}, text: {injected: 0}, output: {bytesWritten: 102400}, duration: 3.42}}

