# full-cli validation-result.yaml-stream
#
# Trace of a CLI run that emits validation findings during an inject.
# Shows the three severities (info / warning / error) and how findings
# reference their rule id back to validation-rules.schema.yaml.
#
# Each line is a YAML document on stdout. Comment / blank lines are for
# human readability only.
#
# Real CLI emits ONLY the YAML lines on stdout; stderr (not shown) would
# carry progress messages aimed at humans.

# ----- stdin: Wrapper sends an inject request -----

{type: request, id: 01HVALIDATE, operation: inject, input: [{path: ./translation, kind: directory}], output: [{path: ./demo-zh.pfs, kind: file}]}

# ----- stdout -----

{type: response, id: 01HVALIDATE, operation: inject, accepted: true}

{type: event, event: started, id: 01HVALIDATE, operation: inject}

{type: event, event: phase, name: reading}

{type: event, event: phase, name: validating}

# error severity: missing placeholder
{type: event, event: validation, rule: player-name, severity: error, source: "Hello {player}", target: "你好", message: "Required placeholder is missing: {player}", path: translation/day1/scene_001.xlf, translation_unit: tu-0042}

# error severity: dropped control code
{type: event, event: validation, rule: control-code, severity: error, source: "[FADE_IN_3]Hello", target: "你好", message: "Engine control code dropped", path: translation/day1/scene_001.xlf, line: 50}

# error severity: target byte overflow
{type: event, event: validation, rule: max-target-bytes, severity: error, source: "...", target: "特别长的目标字节超出", message: "Target exceeds 240 UTF-8 bytes", path: translation/day1/scene_002.xlf, line: 12}

# warning severity: double space (reviewer hint, not blocking)
{type: event, event: validation, rule: suspect-double-space, severity: warning, source: "Hello world", target: "你好  世界", message: "Target contains double space", path: translation/day1/scene_002.xlf, line: 7}

# warning severity: line length
{type: event, event: validation, rule: max-line-length, severity: warning, source: "...", target: "这是一段非常非常长的中文译文行超出了文本框宽度限制", message: "Target exceeds 80 characters", path: translation/day1/scene_002.xlf, line: 7}

# info severity: source had ruby annotation — reviewer's hint
{type: event, event: validation, rule: ruby-annotation-present, severity: info, source: "{ruby:漢字|かんじ}", target: "{ruby:漢字|}", message: "Source had a ruby annotation; target lost the reading", path: translation/intro.xlf}

# info severity: target lacks terminator — reviewer's hint
{type: event, event: validation, rule: terminator-punctuation, severity: info, source: "Have a nice day.", target: "祝你好运", message: "Target does not end with sentence-ending punctuation", path: translation/intro.xlf}

{type: event, event: phase, name: writing}

{type: event, event: file, action: write, path: demo-zh.pfs}

{type: event, event: phase, name: finalizing}

# A summary count of validation findings, by severity, is a nice
# extension. Wrapper MAY aggregate these per operation.
{type: event, event: statistics, statistics: {files: {processed: 3}, text: {injected: 418}, validation: {errors: 3, warnings: 2, info: 2}}}

{type: event, event: completed, id: 01HVALIDATE, statistics: {text: {injected: 418}}}

# exit code depends on whether `error`- severity is configured as blocking.
# In the default mapping used by the full-cli, exit code is 5 (validation failed)
# because at least one error was emitted.